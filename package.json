{
  "name": "curate",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck && tsc --noEmit -p tsconfig.json",
    "test": "pnpm --recursive run test && vitest run"
  },
  "devDependencies": {
    "@types/node": "22.12.0",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "@curatejs/core": "workspace:^",
    "@curatejs/chat": "workspace:^",
    "@curatejs/git": "workspace:^",
    "@curatejs/markdown": "workspace:^",
    "node-llama-cpp": "3.18.1"
  }
}
